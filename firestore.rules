rules_version = '2';

// Farm Time database rules.
// Don't paste this file as-is: open setup.html on the Farm Time site, choose the
// family code there, and it gives you this file with your code's ID filled in.
// Only the folder matching that one code can be read or written; everything else
// in the database is locked.
service cloud.firestore {
  match /databases/{database}/documents {

    function familyId() {
      return 'FAMILY_ID_GOES_HERE';
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validTrip(d) {
      return d.keys().hasOnly(['people', 'start', 'end', 'reason', 'staying', 'notes', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['people', 'start', 'end', 'reason'])
        && d.people is list && d.people.size() > 0 && d.people.size() <= 20
        && isDate(d.start) && isDate(d.end) && d.end >= d.start
        && d.reason is string && d.reason.size() <= 20
        && (!('staying' in d) || d.staying is bool)
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 500));
    }

    function validTodo(d) {
      return d.keys().hasOnly(['text', 'done', 'who', 'due', 'createdAt', 'updatedAt', 'doneAt'])
        && d.keys().hasAll(['text', 'done'])
        && d.text is string && d.text.size() > 0 && d.text.size() <= 200
        && d.done is bool
        && (!('who' in d) || (d.who is string && d.who.size() <= 40))
        && (!('due' in d) || d.due == '' || isDate(d.due));
    }

    match /families/{fam}/todos/{todo} {
      allow read, delete: if fam == familyId();
      allow create, update: if fam == familyId() && validTodo(request.resource.data);
    }

    match /families/{fam}/trips/{trip} {
      allow read, delete: if fam == familyId();
      allow create, update: if fam == familyId() && validTrip(request.resource.data);
    }
  }
}
