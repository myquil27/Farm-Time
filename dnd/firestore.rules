rules_version = '2';

// Gather the Party database rules.
// Don't paste this file as-is: open dnd/setup.html on the site, choose the
// party code there, and it gives you this file with your code's ID filled in.
// Only the folder matching that one code can be read or written; everything else
// in the database is locked.
service cloud.firestore {
  match /databases/{database}/documents {

    function partyId() {
      return 'PARTY_ID_GOES_HERE';
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // One availability sheet per player. "days" maps YYYY-MM-DD to two letters:
    // afternoon then evening, each y (can play), m (maybe), n (can't) or - (no answer).
    function validAvail(d) {
      return d.keys().hasOnly(['days', 'updatedAt'])
        && d.days is map && d.days.size() <= 500
        && (!('updatedAt' in d) || d.updatedAt is number);
    }

    function validSession(d) {
      return d.keys().hasOnly(['date', 'slot', 'time', 'where', 'notes', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['date', 'slot'])
        && isDate(d.date)
        && d.slot in ['a', 'e']
        && (!('time' in d) || (d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('where' in d) || (d.where is string && d.where.size() <= 80))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 500));
    }

    match /parties/{party}/avail/{player} {
      allow read, delete: if party == partyId();
      allow create, update: if party == partyId()
        && player in ['john', 'michael', 'matt-erin', 'chris', 'ryan-lynda']
        && validAvail(request.resource.data);
    }

    match /parties/{party}/sessions/{session} {
      allow read, delete: if party == partyId();
      allow create, update: if party == partyId() && validSession(request.resource.data);
    }
  }
}
